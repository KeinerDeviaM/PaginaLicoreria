:root {
  --bg: #0f0f10;
  --panel: #18181b;
  --panel-2: #212124;
  --border: #2b2b31;
  --text: #f4f4f5;
  --muted: #b8b8c2;
  --gold: #d4af37;
  --wine: #722f37;
  --success: #16a34a;
  --danger: #dc2626;
  --warning: #d97706;
  --info: #2563eb;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Inter, system-ui, Arial, sans-serif;
  background: radial-gradient(circle at top right, rgba(212,175,55,.08), transparent 25%), var(--bg);
  color: var(--text);
}
a { color: inherit; text-decoration: none; }
button, input, select, textarea {
  font: inherit;
}
button {
  cursor: pointer;
}
.container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
}
.page {
  padding: 24px 0 32px;
}
.card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 16px;
  box-shadow: 0 10px 30px rgba(0,0,0,.22);
}
.grid {
  display: grid;
  gap: 16px;
}
.grid-2 { grid-template-columns: repeat(2, minmax(0,1fr)); }
.grid-3 { grid-template-columns: repeat(3, minmax(0,1fr)); }
.grid-4 { grid-template-columns: repeat(4, minmax(0,1fr)); }
@media (max-width: 900px) {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
}
h1,h2,h3,h4,p { margin-top: 0; }
input, select, textarea {
  width: 100%;
  background: var(--panel-2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 12px;
  padding: 12px;
}
label {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 14px;
}
.form-group { margin-bottom: 14px; }
.btn {
  border: none;
  background: var(--panel-2);
  color: var(--text);
  padding: 11px 14px;
  border-radius: 12px;
  transition: .2s ease;
}
.btn:hover { filter: brightness(1.08); }
.btn-primary { background: var(--gold); color: #121212; font-weight: 700; }
.btn-danger { background: var(--danger); color: white; }
.btn-success { background: var(--success); color: white; }
.btn-outline { border: 1px solid var(--border); background: transparent; }
.btn-wine { background: var(--wine); color: white; }
.stack { display: flex; gap: 12px; flex-wrap: wrap; }
.nav {
  position: sticky;
  top: 0;
  z-index: 30;
  background: rgba(15,15,16,.94);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  width: min(1300px, calc(100% - 24px));
  margin: 0 auto;
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.brand { display:flex; align-items:center; gap:10px; font-weight:700; }
.brand-badge {
  display:grid; place-items:center;
  width: 38px; height: 38px; border-radius: 12px;
  background: linear-gradient(135deg, var(--gold), #8b6b1b);
  color: #131313;
}
.nav-links { display:flex; align-items:center; gap:14px; flex-wrap: wrap; }
.nav-link { color: var(--muted); font-size: 14px; }
.nav-link.active, .nav-link:hover { color: var(--gold); }
.kpi {
  padding: 18px; border-radius: 18px; background: var(--panel);
  border: 1px solid var(--border);
}
.kpi .value { font-size: 32px; font-weight: 800; }
.kpi .label { color: var(--muted); font-size: 14px; }
.table-wrap { overflow:auto; }
table { width: 100%; border-collapse: collapse; }
th, td {
  text-align:left;
  padding: 12px 10px;
  border-bottom: 1px solid var(--border);
}
th { color: var(--muted); font-size: 13px; }
.badge {
  display:inline-block; padding:6px 10px; border-radius:999px;
  font-size:12px; font-weight:700;
}
.badge.gold { background: rgba(212,175,55,.14); color: var(--gold); }
.badge.success { background: rgba(22,163,74,.14); color: #7ef0a0; }
.badge.danger { background: rgba(220,38,38,.14); color: #ff9a9a; }
.badge.warning { background: rgba(217,119,6,.14); color: #ffc56b; }
.badge.info { background: rgba(37,99,235,.14); color: #9ec0ff; }
.hero {
  padding: 56px 0 32px;
}
.hero h1 { font-size: 52px; line-height: 1.03; }
.hero p { color: var(--muted); max-width: 700px; }
.product-grid { display:grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap:16px; }
@media (max-width: 1000px) { .product-grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
@media (max-width: 640px) { .product-grid { grid-template-columns: 1fr; } .hero h1 { font-size: 36px; } }
.product-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
}
.product-image {
  height: 220px;
  display:grid;
  place-items:center;
  background: linear-gradient(180deg, #1d1d21, #111113);
  color: var(--gold);
  font-size: 40px;
  font-weight: 800;
}
.product-body { padding: 16px; }
.small { color: var(--muted); font-size: 13px; }
.layout {
  display:grid;
  grid-template-columns: 260px 1fr;
  min-height: calc(100vh - 70px);
}
@media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
.sidebar {
  background: var(--panel);
  border-right: 1px solid var(--border);
  padding: 20px 14px;
}
.sidebar .menu { display:flex; flex-direction: column; gap:8px; }
.sidebar .menu a {
  padding: 11px 12px;
  border-radius: 12px;
  color: var(--muted);
}
.sidebar .menu a.active, .sidebar .menu a:hover {
  background: rgba(212,175,55,.1);
  color: var(--gold);
}
.main { padding: 20px; }
.notice {
  border-radius: 14px;
  padding: 12px 14px;
  margin-bottom: 14px;
}
.notice.error { background: rgba(220,38,38,.14); color: #ff9a9a; }
.notice.success { background: rgba(22,163,74,.14); color: #7ef0a0; }
.notice.info { background: rgba(37,99,235,.14); color: #9ec0ff; }
.notice.warning { background: rgba(217,119,6,.14); color: #ffc56b; }
.split {
  display:grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 16px;
}
@media (max-width: 960px) { .split { grid-template-columns: 1fr; } }
hr.sep {
  border: none;
  border-top: 1px solid var(--border);
  margin: 16px 0;
}
.bar-list { display: grid; gap: 12px; margin-top: 12px; }
.bar-row { display: grid; gap: 6px; }
.bar-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.bar-track { width: 100%; height: 10px; background: rgba(255,255,255,0.08); border-radius: 999px; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, var(--gold), #f5d97b); border-radius: 999px; }
.invoice-sheet { background: #fff; color: #111; border-radius: 18px; padding: 24px; }
.invoice-header { display: flex; justify-content: space-between; gap: 16px; border-bottom: 2px solid #e7e7e7; padding-bottom: 14px; }
.invoice-totals { margin-top: 18px; display: grid; gap: 6px; justify-content: end; }
@media print {
  body { background: #fff; }
  .nav, .sidebar, .btn, .notice, .no-print { display: none !important; }
  .main, .page, .container { padding: 0 !important; width: 100% !important; margin: 0 !important; }
  .card { box-shadow: none !important; border: none !important; background: transparent !important; }
  .printable-invoice-wrapper { grid-template-columns: 1fr !important; }
  .invoice-sheet { box-shadow: none; border: none; }
}

.floating-toast {
  position: fixed;
  top: 86px;
  right: 22px;
  z-index: 1200;
  min-width: 300px;
  max-width: 420px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 14px 16px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 18px 45px rgba(0,0,0,0.35);
  backdrop-filter: blur(12px);
  animation: toastIn .22s ease;
}

.floating-toast.success {
  background: linear-gradient(135deg, rgba(22,163,74,0.22), rgba(10,18,12,0.95));
  color: #d7ffe3;
}

.floating-toast.warning {
  background: linear-gradient(135deg, rgba(217,119,6,0.24), rgba(24,16,8,0.95));
  color: #ffe4b0;
}

.floating-toast.error {
  background: linear-gradient(135deg, rgba(220,38,38,0.24), rgba(24,10,10,0.95));
  color: #ffd1d1;
}

.floating-toast-icon {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-weight: 800;
  flex: 0 0 34px;
  background: rgba(255,255,255,0.12);
}

.product-card-out {
  opacity: 0.88;
}

.product-stock-row {
  margin: 10px 0 14px;
}

.stock-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .01em;
}

.stock-pill.success {
  background: rgba(22,163,74,.14);
  color: #8cf0af;
}

.stock-pill.warning {
  background: rgba(217,119,6,.16);
  color: #ffd27e;
}

.stock-pill.danger {
  background: rgba(220,38,38,.14);
  color: #ffadad;
}

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translateY(-8px) scale(.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 640px) {
  .floating-toast {
    left: 16px;
    right: 16px;
    top: 78px;
    min-width: auto;
    max-width: none;
  }
}

.global-toast-stack {
  position: fixed;
  top: 84px;
  right: 22px;
  z-index: 1300;
  display: flex;
  flex-direction: column;
  gap: 12px;
  pointer-events: none;
}

.global-toast-stack .floating-toast {
  pointer-events: auto;
}

.toast-close {
  background: transparent;
  border: none;
  color: inherit;
  font-size: 18px;
  font-weight: 800;
  cursor: pointer;
  opacity: .8;
}

.toast-close:hover {
  opacity: 1;
}

.confirm-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1400;
  background: rgba(0,0,0,.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  backdrop-filter: blur(4px);
}

.confirm-modal {
  width: 100%;
  max-width: 460px;
  background: linear-gradient(180deg, rgba(27,27,27,.98), rgba(16,16,16,.98));
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 22px;
  padding: 22px;
  box-shadow: 0 20px 50px rgba(0,0,0,.4);
}

.confirm-modal h3 {
  margin-bottom: 10px;
}

.confirm-modal p {
  color: rgba(255,255,255,.82);
  line-height: 1.5;
}

@media (max-width: 640px) {
  .global-toast-stack {
    left: 16px;
    right: 16px;
    top: 76px;
  }
}

/* =========================
   PAQUETE VISUAL 2
   ========================= */

/* Reveal on scroll */
.reveal-on-scroll {
  opacity: 0;
  transform: translateY(18px) scale(.985);
  transition:
    opacity .65s ease,
    transform .65s ease,
    filter .65s ease;
  filter: blur(4px);
}

.reveal-on-scroll.revealed {
  opacity: 1;
  transform: translateY(0) scale(1);
  filter: blur(0);
}

/* Skeleton shimmer */
.skeleton,
.skeleton-line,
.skeleton-box {
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    90deg,
    rgba(255,255,255,0.05) 0%,
    rgba(255,255,255,0.08) 20%,
    rgba(255,255,255,0.05) 40%
  );
  background-size: 200% 100%;
  animation: skeletonShimmer 1.4s linear infinite;
  border-radius: 12px;
}

.skeleton-line {
  height: 14px;
  margin: 8px 0;
}

.skeleton-box {
  min-height: 180px;
}

@keyframes skeletonShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Hero / home glow */
.hero,
.home-hero,
.banner,
[class*="hero"] {
  position: relative;
  overflow: hidden;
}

.hero::before,
.home-hero::before,
.banner::before,
[class*="hero"]::before {
  content: "";
  position: absolute;
  inset: -20%;
  background:
    radial-gradient(circle at 20% 20%, rgba(212,175,55,0.12), transparent 22%),
    radial-gradient(circle at 80% 20%, rgba(255,255,255,0.06), transparent 18%),
    radial-gradient(circle at 50% 80%, rgba(212,175,55,0.08), transparent 24%);
  pointer-events: none;
  animation: heroFloatGlow 10s ease-in-out infinite alternate;
}

@keyframes heroFloatGlow {
  from { transform: translateY(0) scale(1); opacity: .8; }
  to { transform: translateY(-8px) scale(1.03); opacity: 1; }
}

/* Catálogo / cards premium */
.catalog-card,
.product-card,
[class*="catalog"] .card,
[class*="product-grid"] .card,
[class*="products-grid"] .card {
  position: relative;
  isolation: isolate;
}

.catalog-card::after,
.product-card::after,
[class*="catalog"] .card::after,
[class*="product-grid"] .card::after,
[class*="products-grid"] .card::after {
  content: "";
  position: absolute;
  inset: auto 10% 0 10%;
  height: 20px;
  background: radial-gradient(ellipse at center, rgba(212,175,55,0.16), transparent 70%);
  filter: blur(12px);
  opacity: 0;
  transition: opacity .28s ease;
  z-index: -1;
}

.catalog-card:hover::after,
.product-card:hover::after,
[class*="catalog"] .card:hover::after,
[class*="product-grid"] .card:hover::after,
[class*="products-grid"] .card:hover::after {
  opacity: 1;
}

.catalog-card:hover,
.product-card:hover,
[class*="catalog"] .card:hover,
[class*="product-grid"] .card:hover,
[class*="products-grid"] .card:hover {
  transform: translateY(-6px) scale(1.01);
}

/* Imagen con spotlight */
.product-image-wrap,
[class*="image-wrap"] {
  position: relative;
  overflow: hidden;
  border-radius: 16px;
}

.product-image-wrap::before,
[class*="image-wrap"]::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.08), transparent 35%, transparent 65%, rgba(212,175,55,0.08));
  opacity: .55;
  pointer-events: none;
  transition: opacity .28s ease;
}

.product-image-wrap:hover::before,
[class*="image-wrap"]:hover::before {
  opacity: .95;
}

/* Etiquetas/precios */
.price,
[class*="price"],
strong.price {
  transition: transform .2s ease, color .2s ease;
}

.card:hover .price,
.card:hover [class*="price"] {
  transform: translateY(-1px);
}

/* Tablas más premium */
table {
  border-collapse: separate;
  border-spacing: 0;
}

table thead th {
  background: rgba(255,255,255,0.03);
  backdrop-filter: blur(4px);
}

table tbody tr td:first-child {
  border-left: 1px solid rgba(255,255,255,0.04);
}

table tbody tr td:last-child {
  border-right: 1px solid rgba(255,255,255,0.04);
}

/* Contenedores con reveal automático */
.page .card,
.page .table-wrap,
.page form,
.page .notice,
.page .split > section {
  will-change: transform, opacity;
}

/* Animación suave para bloques importantes */
.page .card,
.page .table-wrap,
.page .split > section,
.page form {
  animation: subtleLiftIn .45s ease both;
}

@keyframes subtleLiftIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Números/estadísticas */
.stat-card,
.metric-card,
[class*="stat"] .card,
[class*="metric"] .card {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.02)),
    linear-gradient(135deg, rgba(212,175,55,0.06), transparent 55%);
}

/* Overlay de lujo en imágenes grandes */
img.hero-image,
img.banner-image,
.card img:first-child {
  transition: transform .45s ease, filter .35s ease;
}

.card:hover img.hero-image,
.card:hover img.banner-image,
.card:hover img:first-child {
  filter: brightness(1.04) contrast(1.03);
}

/* Chips y filtros */
select:hover,
input:hover,
textarea:hover {
  border-color: rgba(212,175,55,0.22);
}

/* Navbar / headers pegajosos un poco más premium */
header,
nav {
  backdrop-filter: blur(8px);
}

/* Microanimación para íconos */
svg,
i {
  transition: transform .2s ease, opacity .2s ease;
}

.btn:hover svg,
.btn:hover i,
.card:hover svg,
.card:hover i {
  transform: translateY(-1px);
}

/* Hover sutil para links de texto */
a:hover {
  opacity: .95;
}

/* Botones de tabla / acciones */
.table-wrap .btn,
table .btn {
  box-shadow: none;
}

.table-wrap .btn:hover,
table .btn:hover {
  box-shadow: 0 8px 18px rgba(0,0,0,0.2);
}

/* Responsive fine tuning */
@media (max-width: 768px) {
  .catalog-card:hover,
  .product-card:hover,
  [class*="catalog"] .card:hover,
  [class*="product-grid"] .card:hover,
  [class*="products-grid"] .card:hover {
    transform: translateY(-3px) scale(1.005);
  }

  .reveal-on-scroll {
    transform: translateY(10px);
    filter: blur(2px);
  }
}
